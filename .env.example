# Configuración del despliegue con Docker (compose.yaml).
# Copiar a .env (en esta misma carpeta) y completar. Nunca subir el .env real al repositorio.
# Usar solo letras y números en las claves de MySQL (van dentro de una URL de conexión).

# --- Imágenes ---
# Para publicar en Docker Hub: IMAGE_PREFIX=usuario/   (con la barra final)
IMAGE_PREFIX=
IMAGE_TAG=1.0.0

# --- MySQL ---
MYSQL_DATABASE=ianalytics
MYSQL_USER=ianalytics
MYSQL_PASSWORD=cambiar_clave_mysql
MYSQL_ROOT_PASSWORD=cambiar_clave_root
MYSQL_PUBLISHED_PORT=3307

# --- Django ---
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
BACKEND_PUBLISHED_PORT=8000
GUNICORN_WORKERS=3

# Con HTTPS (dominio real detrás de un proxy):
# DJANGO_SECURE_COOKIES=True, DJANGO_SECURE_SSL_REDIRECT=True, DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Administrador inicial (se crea solo si no existe; la clave no se cambia después)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiar_clave_admin
DJANGO_SUPERUSER_EMAIL=contacto@ianalytics.cl

# Carga los textos del mockup la primera vez (si la base está vacía)
LOAD_INITIAL_CONTENT=True

# --- Panel de administración (/panel/ del frontend) ---
# Dirección pública del admin de Django (botón "Gestionar usuarios"); usar el mismo puerto
# que BACKEND_PUBLISHED_PORT, o el dominio del backend en producción
DJANGO_ADMIN_PUBLIC_URL=http://localhost:8000/admin/
# Horas que dura una sesión del panel
TOKEN_TTL_HOURS=12

# --- Frontend (sitio público en Astro) ---
FRONTEND_PUBLISHED_PORT=4321
# Dominio público: enlaces canónicos, hreflang y Open Graph (se aplica al construir la imagen)
PUBLIC_SITE_URL=https://ianalytics.cl
# Segundos que el frontend guarda en memoria el contenido de cada idioma
CONTENT_CACHE_SECONDS=30
# true solo detrás de un proxy (nginx/Caddy) que envía la IP real del visitante;
# así el límite de envíos del formulario se aplica por visitante
TRUST_FORWARDED_FOR=false
# El frontend llama al backend por la red interna de Docker; CORS solo hace falta para
# otros orígenes que consuman la API directo desde el navegador
CORS_ALLOWED_ORIGINS=

# --- Traducción automática: none | deepl | libretranslate ---
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- Correo (avisos de mensajes de contacto) ---
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=no-reply@ianalytics.cl
CONTACT_NOTIFICATION_EMAILS=

MAX_UPLOAD_SIZE_MB=5
