# Copiar a backend/.env y completar. Nunca subir el .env real al repositorio.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Producción con HTTPS: DJANGO_SECURE_SSL_REDIRECT=True y DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Base de datos ---
# Vacío = SQLite local (backend/db.sqlite3). Para usar el MySQL de Docker desde el equipo
# (puerto publicado 3307; requiere pip install -r requirements_production.txt):
# DATABASE_URL=mysql://ianalytics:clave@127.0.0.1:3307/ianalytics
DATABASE_URL=

# --- Archivos ---
MAX_UPLOAD_SIZE_MB=5

# --- Frontend ---
# Dirección pública del sitio (enlace "Ver el sitio" del admin)
FRONTEND_PUBLIC_URL=http://localhost:4321/
# Orígenes que pueden consumir la API directo desde el navegador
# (el frontend en Astro llama al backend desde el servidor y no lo necesita)
CORS_ALLOWED_ORIGINS=

# --- Traducción automática: none | deepl | libretranslate ---
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
LIBRETRANSLATE_URL=http://localhost:5000/translate
LIBRETRANSLATE_API_KEY=

# --- Correo para avisos de mensajes de contacto ---
# consolemail:// muestra los correos en la consola (desarrollo)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=no-reply@ianalytics.cl
CONTACT_NOTIFICATION_EMAILS=

# --- Límites de uso de la API pública ---
CONTACT_THROTTLE_RATE=5/hour
PAGE_CONTENT_THROTTLE_RATE=120/minute
