# Desarrollo local del frontend (npm run dev). Copiar a .env si se necesita cambiar algo.

# URL del backend desde el servidor de Astro (en Docker: http://backend:8000)
BACKEND_INTERNAL_URL=http://localhost:8000

# Segundos que se guarda en memoria el contenido de cada idioma
CONTENT_CACHE_SECONDS=30

# Tiempo máximo de espera al backend antes de usar el contenido de respaldo (src/i18n/*.json)
BACKEND_TIMEOUT_MS=3000

# true solo detrás de un proxy que envía la IP real del visitante en X-Forwarded-For
TRUST_FORWARDED_FOR=false

# Dominio público (enlaces canónicos, hreflang y Open Graph)
PUBLIC_SITE_URL=https://ianalytics.cl
