# syntax=docker/dockerfile:1
# Imagen del frontend de iAnalytics (Astro con renderizado en servidor sobre Node.js)

# --- Etapa 1: instalar dependencias y construir el sitio ---------------------
FROM node:22-alpine AS builder

# Dominio público: Astro lo usa al construir para los enlaces canónicos, hreflang y Open Graph
ARG PUBLIC_SITE_URL=https://ianalytics.cl
ENV ASTRO_TELEMETRY_DISABLED=1 \
    PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build \
    && npm prune --omit=dev


# --- Etapa 2: imagen final, solo lo necesario para ejecutar --------------------
FROM node:22-alpine AS runtime

LABEL org.opencontainers.image.title="ianalytics_frontend" \
      org.opencontainers.image.description="Sitio web de Informatic Analytics (Astro)" \
      org.opencontainers.image.vendor="Informatic Analytics"

ENV NODE_ENV=production \
    ASTRO_TELEMETRY_DISABLED=1 \
    HOST=0.0.0.0 \
    PORT=4321 \
    BACKEND_INTERNAL_URL=http://backend:8000 \
    CONTENT_CACHE_SECONDS=30

WORKDIR /app

COPY --from=builder --chown=node:node /build/package.json ./
COPY --from=builder --chown=node:node /build/node_modules ./node_modules
COPY --from=builder --chown=node:node /build/dist ./dist

# Usuario sin privilegios incluido en la imagen oficial de Node
USER node

EXPOSE 4321

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:4321/health || exit 1

CMD ["node", "./dist/server/entry.mjs"]
