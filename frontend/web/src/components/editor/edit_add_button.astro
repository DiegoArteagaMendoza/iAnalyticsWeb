---
/** Botón "+ Agregar" del editor: crea un elemento nuevo (sin publicar) en una lista. */
interface Props {
  endpoint: string;
  label: string;
  defaults: Record<string, unknown>;
  /** Se usa en listas sobre fondo oscuro */
  tone?: "light" | "dark";
  class?: string;
}

const { endpoint, label, defaults, tone = "light", class: class_name } = Astro.props;
---

<button
  type="button"
  class:list={["edit_add_button", `tone_${tone}`, class_name]}
  data-edit-add={endpoint}
  data-defaults={JSON.stringify({ is_published: false, ...defaults })}
>
  + {label}
</button>

<style>
  .edit_add_button {
    display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 64px; width: 100%;
    font: 600 0.9rem var(--sans); cursor: pointer; padding: 16px;
    border: 2px dashed var(--blue); background: rgba(28, 99, 168, 0.06); color: var(--blue);
    transition: background var(--ease);
  }
  .edit_add_button:hover { background: rgba(28, 99, 168, 0.14); }
  .tone_dark { border-color: var(--yellow); color: var(--yellow); background: rgba(242, 183, 5, 0.08); }
  .tone_dark:hover { background: rgba(242, 183, 5, 0.16); }
</style>
