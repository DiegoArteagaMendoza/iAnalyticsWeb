---
import { edit_image, edit_item, edit_link, edit_section, edit_text } from "../../lib/edit_attrs";
import { format_text, get_ui, type Language } from "../../lib/i18n";
import type { TeamMember, TeamSection } from "../../lib/types";
import SectionHeading from "../common/section_heading.astro";
import EditAddButton from "../editor/edit_add_button.astro";

interface Props {
  team: TeamSection;
  language: Language;
  editing?: boolean;
}

const { team, language, editing = false } = Astro.props;
const ui = get_ui(language);
const linkedin_label = (member: TeamMember) => format_text(ui.team.linkedin_of, { name: member.full_name });
const target = (field: string) => ["team_section", null, field] as [string, null, string];
const member_target = (member: TeamMember, field: string) => ["team_members", member.id, field] as [string, number, string];
const item = (member: TeamMember, label: string) =>
  edit_item(editing, "team_members", member.id, { is_published: member.is_published, accent_color: member.accent_color, label });
const new_member = (is_founder: boolean, order: number) => ({
  full_name: is_founder ? "Nombre Fundador" : "Nombre Persona",
  role_es: is_founder ? "Cofundador" : "Cargo",
  is_founder,
  accent_color: "yellow",
  order,
});
---

<section class="team" id="equipo" aria-labelledby="team_title" {...edit_section(editing, "team_section", team.is_visible, "Equipo")}>
  <div class="wrap">
    <SectionHeading {...team} eyebrow_color="blue" heading_id="team_title" editing={editing} endpoint="team_section" has_cta={false} />

    {
      (editing || team.founders.length > 0) && (
        <>
          {(editing || team.founders_label) && (
            <h3 class="sub_heading reveal"><span {...edit_text(editing, target("founders_label"), { placeholder: "Fundadores" })}>{team.founders_label}</span></h3>
          )}
          <div class="founders">
            {team.founders.map((member) => (
              <article class="founder reveal" {...item(member, "fundador/a")}>
                <div class={`photo accent_${member.accent_color}`} {...edit_image(editing, member_target(member, "photo"), "Cambiar foto")}>
                  {member.photo ? (
                    <img src={member.photo} alt={member.full_name} loading="lazy" />
                  ) : (
                    <span aria-hidden="true">{member.initials}</span>
                  )}
                </div>
                <div class="body">
                  <div class="role" {...edit_text(editing, member_target(member, "role"), { placeholder: "Cargo" })}>{member.role}</div>
                  <h3 {...edit_text(editing, member_target(member, "full_name"), { translatable: false, placeholder: "Nombre" })}>{member.full_name}</h3>
                  {(editing || member.bio) && (
                    <p {...edit_text(editing, member_target(member, "bio"), { multiline: true, placeholder: "Reseña breve" })}>{member.bio}</p>
                  )}
                  {(editing || member.linkedin_url) && (
                    <a
                      class="social"
                      href={member.linkedin_url || "#"}
                      target="_blank"
                      rel="noopener"
                      aria-label={linkedin_label(member)}
                      {...edit_link(editing, member_target(member, "linkedin_url"))}
                    >
                      <b aria-hidden="true">in</b>LinkedIn
                    </a>
                  )}
                </div>
              </article>
            ))}
            {editing && (
              <EditAddButton endpoint="team_members" label="Fundador/a" defaults={new_member(true, team.founders.length)} />
            )}
          </div>
        </>
      )
    }

    {
      (editing || team.members.length > 0) && (
        <>
          {(editing || team.members_label) && (
            <h3 class="sub_heading reveal"><span {...edit_text(editing, target("members_label"), { placeholder: "Equipo" })}>{team.members_label}</span></h3>
          )}
          <div class="members">
            {team.members.map((member) => (
              <article class="member reveal" {...item(member, "integrante")}>
                <div class={`photo accent_${member.accent_color}`} {...edit_image(editing, member_target(member, "photo"), "Cambiar foto")}>
                  {member.photo ? (
                    <img src={member.photo} alt={member.full_name} loading="lazy" />
                  ) : (
                    <span aria-hidden="true">{member.initials}</span>
                  )}
                </div>
                <div class="body">
                  <h3>
                    {editing ? (
                      <span {...edit_text(editing, member_target(member, "full_name"), { translatable: false, placeholder: "Nombre" })}>{member.full_name}</span>
                    ) : member.linkedin_url ? (
                      <a href={member.linkedin_url} target="_blank" rel="noopener" aria-label={linkedin_label(member)}>{member.full_name}</a>
                    ) : (
                      member.full_name
                    )}
                  </h3>
                  <p class="role" {...edit_text(editing, member_target(member, "role"), { placeholder: "Cargo" })}>{member.role}</p>
                  {editing && (
                    <a class="social small" href={member.linkedin_url || "#"} {...edit_link(editing, member_target(member, "linkedin_url"))}>
                      <b aria-hidden="true">in</b>LinkedIn
                    </a>
                  )}
                </div>
              </article>
            ))}
            {editing && <EditAddButton endpoint="team_members" label="Integrante" defaults={new_member(false, team.members.length)} />}
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .team { background: var(--surface); }
  .founders { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 48px; }
  .founder { display: grid; grid-template-columns: 220px 1fr; background: var(--paper); }
  .photo { position: relative; background: var(--base); display: grid; place-items: center; overflow: hidden; aspect-ratio: 4 / 5; }
  .photo::before {
    content: ""; position: absolute; inset: auto -20% -30% auto; width: 90%; aspect-ratio: 1;
    border-radius: 50%; background: var(--accent); opacity: 0.9;
  }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .photo span { position: relative; font-family: var(--serif); font-weight: 700; font-size: 3rem; color: var(--paper); }
  .founder .body { padding: 32px; display: flex; flex-direction: column; }
  .role { font: 600 0.78rem var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--green); margin-bottom: 8px; }
  .founder h3 { font-size: 1.6rem; margin-bottom: 12px; }
  .founder p { color: var(--muted); font-size: 0.98rem; margin-bottom: 20px; flex: 1; }
  .social { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; color: var(--blue); align-self: flex-start; }
  .social b { display: grid; place-items: center; width: 28px; height: 28px; background: var(--blue); color: #fff; font-size: 0.75rem; }
  .social:hover { text-decoration: underline; }
  .social.small { margin-top: 12px; font-size: 0.8rem; }
  .social.small b { width: 22px; height: 22px; }
  .members { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .member { background: var(--paper); transition: transform var(--ease), box-shadow var(--ease); }
  .member:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(18, 32, 43, 0.12); }
  .member .photo { aspect-ratio: 1; }
  .member .photo span { font-size: 2.25rem; }
  .member .body { padding: 20px 22px 24px; }
  .member h3 { font-size: 1.15rem; margin-bottom: 4px; }
  .member h3 a { text-decoration: none; }
  .member h3 a:hover { text-decoration: underline; }
  .member .role { margin: 0; color: var(--muted); letter-spacing: 0.06em; }
  @media (max-width: 991px) {
    .founders { grid-template-columns: 1fr; }
    .members { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .founder { grid-template-columns: 1fr; }
    .founder .photo { aspect-ratio: 16 / 10; }
    .founder .body { padding: 24px; }
    .members { gap: 16px; }
    .member .body { padding: 16px; }
  }
</style>
