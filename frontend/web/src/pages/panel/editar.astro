---
import PanelLayout from "../../layouts/panel_layout.astro";
import { home_path, is_language } from "../../lib/i18n";

const user = Astro.locals.panel_user!;
const requested = Astro.url.searchParams.get("lang");
const language = is_language(requested) ? requested : "es";
const languages = [
  { code: "es", label: "Español" },
  { code: "en", label: "Inglés" },
] as const;
---

<PanelLayout title="Editar" active="editar" user={user} full_bleed>
  <div class="editor_toolbar">
    <div class="group" role="group" aria-label="Idioma que se edita">
      <span class="label">Editando</span>
      {
        languages.map((item) => (
          <a class="segment" href={`/panel/editar?lang=${item.code}`} aria-current={item.code === language ? "page" : undefined}>{item.label}</a>
        ))
      }
    </div>
    <div class="group" role="group" aria-label="Tamaño de la vista previa">
      <span class="label">Vista</span>
      <button class="segment" type="button" data-width="100%" aria-pressed="true">Escritorio</button>
      <button class="segment" type="button" data-width="820px" aria-pressed="false">Tablet</button>
      <button class="segment" type="button" data-width="390px" aria-pressed="false">Móvil</button>
    </div>
    <div class="group end">
      <button class="plain" type="button" data-reload title="Recargar la vista previa">⟳ Recargar</button>
      <a class="plain" href={home_path(language)} target="_blank" rel="noopener">↗ Ver sitio publicado</a>
    </div>
  </div>
  <p class="editor_help">
    Haz clic en un texto para editarlo; se guarda al salir del campo (<kbd>Enter</kbd> en una línea, <kbd>Esc</kbd> deshace).
    Pasa el mouse sobre fotos y botones para cambiar imágenes y enlaces. Cada elemento tiene su barra para publicar, mover, cambiar color o eliminar.
    {language === "en" && <strong> Estás editando la versión en inglés: los cambios no afectan al español.</strong>}
  </p>
  <div class="preview_stage">
    <iframe id="preview_frame" src={`/panel/vista_previa?lang=${language}`} title="Vista previa editable de la página"></iframe>
  </div>
</PanelLayout>

<script>
  const frame = document.getElementById("preview_frame") as HTMLIFrameElement;
  const size_buttons = document.querySelectorAll<HTMLButtonElement>("[data-width]");
  size_buttons.forEach((button) =>
    button.addEventListener("click", () => {
      frame.style.width = button.dataset.width ?? "100%";
      size_buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
    }),
  );
  document.querySelector("[data-reload]")?.addEventListener("click", () => frame.contentWindow?.location.reload());
</script>

<style>
  .editor_toolbar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: 12px 20px;
    background: var(--paper); border-bottom: 1px solid var(--line);
  }
  .group { display: flex; align-items: center; gap: 4px; }
  .group.end { margin-left: auto; gap: 12px; }
  .label { font: 600 0.75rem var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-right: 6px; }
  .segment {
    font: 500 0.88rem var(--sans); padding: 6px 12px; border: 1px solid var(--line); background: var(--paper);
    color: var(--base); text-decoration: none; cursor: pointer;
  }
  .segment:first-of-type { border-radius: 6px 0 0 6px; }
  .segment:last-child { border-radius: 0 6px 6px 0; }
  .segment[aria-current="page"], .segment[aria-pressed="true"] { background: var(--base); border-color: var(--base); color: var(--paper); }
  .plain { font: 500 0.88rem var(--sans); background: none; border: 0; color: var(--blue); cursor: pointer; text-decoration: none; }
  .plain:hover { text-decoration: underline; }
  .editor_help { margin: 0; padding: 8px 20px; font-size: 0.82rem; color: var(--muted); background: var(--yellow_soft); border-bottom: 1px solid var(--line); }
  kbd { font: 600 0.75rem var(--sans); padding: 1px 5px; border: 1px solid var(--line); border-radius: 3px; background: var(--paper); }
  .preview_stage { flex: 1; min-height: 0; display: flex; justify-content: center; background: #d9ddd9; padding: 16px; overflow: auto; }
  iframe { width: 100%; height: 100%; min-height: 600px; border: 0; background: var(--paper); box-shadow: 0 8px 30px rgba(18, 32, 43, 0.2); transition: width 0.25s ease; }
</style>
